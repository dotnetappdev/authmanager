@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using AuthManager.UI.Components.Layout

<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="exception">
                <LayoutView Layout="typeof(MainLayout)">
                    <AuthManagerErrorPanel Exception="exception" OnDismiss="() => _errorBoundary?.Recover()" />
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
    <NotFound>
        <PageTitle>Not Found</PageTitle>
        <LayoutView Layout="typeof(MainLayout)">
            <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="3">
                <MudText Typo="Typo.h4">404 — Page Not Found</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">The page you requested does not exist.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/authmanager">Back to Dashboard</MudButton>
            </MudStack>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private ErrorBoundary? _errorBoundary;
}

