@page "/authmanager/logs"
@rendermode InteractiveServer
@inject ILogAggregationService LogService
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>Log Viewer — Auth Manager</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <div>
        <MudText Typo="Typo.h4">Log Viewer</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Real-time application log aggregation via Serilog</MudText>
    </div>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Color="@(_liveMode ? Color.Primary : Color.Default)"
                   StartIcon="@Icons.Material.Filled.Sync" OnClick="ToggleLive">
            @(_liveMode ? "Live (On)" : "Live (Off)")
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refresh">
            Refresh
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearLogs">
            Clear All
        </MudButton>
    </MudStack>
</MudStack>

<MudCard Elevation="0" Class="am-card-border">
    <MudCardContent>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-3">
            <MudTextField T="string" Value="_filter.SearchTerm" ValueChanged="OnFilterChanged" Placeholder="Search log messages..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:260px;flex:1" />
            <MudSelect T="LogLevel?" @bind-Value="_filter.MinLevel" @bind-Value:after="LoadLogs" Label="Level"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px">
                <MudSelectItem T="LogLevel?" Value="@((LogLevel?)null)">All Levels</MudSelectItem>
                <MudSelectItem T="LogLevel?" Value="@LogLevel.Verbose">Verbose+</MudSelectItem>
                <MudSelectItem T="LogLevel?" Value="@LogLevel.Debug">Debug+</MudSelectItem>
                <MudSelectItem T="LogLevel?" Value="@LogLevel.Information">Info+</MudSelectItem>
                <MudSelectItem T="LogLevel?" Value="@LogLevel.Warning">Warning+</MudSelectItem>
                <MudSelectItem T="LogLevel?" Value="@LogLevel.Error">Error+</MudSelectItem>
                <MudSelectItem T="LogLevel?" Value="@LogLevel.Fatal">Fatal</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" @bind-Value="_filter.SourceContext" @bind-Value:after="LoadLogs" Label="Source"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:200px">
                <MudSelectItem T="string" Value="@("")">All Sources</MudSelectItem>
                @foreach (var ctx in _sourceContexts)
                {
                    <MudSelectItem T="string" Value="@ctx">@ctx</MudSelectItem>
                }
            </MudSelect>
        </MudStack>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_result?.Items.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-6" Style="text-align:center">
                No log entries @(string.IsNullOrEmpty(_filter.SearchTerm) ? "yet. Logs from Serilog will appear here." : "matching your filters.")
            </MudText>
        }
        else
        {
            <MudTable Items="_result!.Items" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm"
                      T="LogEntry" RowsPerPage="0">
                <HeaderContent>
                    <MudTh Style="width:110px">Time</MudTh>
                    <MudTh Style="width:80px">Level</MudTh>
                    <MudTh Style="width:160px">Source</MudTh>
                    <MudTh>Message</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTr @onclick="@(() => ExpandLog(context))" Style="cursor:pointer">
                        <MudTd DataLabel="Time">
                            <MudTooltip Text="@context.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")">
                                <MudText Typo="Typo.caption">@context.Timestamp.ToString("HH:mm:ss.fff")</MudText>
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Level">
                            <MudChip T="string" Size="Size.Small" Color="@LevelColor(context.Level)" Variant="Variant.Filled">
                                @context.Level.ToString()[..4]
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Source">
                            <MudTooltip Text="@context.SourceContext">
                                <MudText Typo="Typo.caption">@ShortSource(context.SourceContext)</MudText>
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Message">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.body2" Style="white-space:normal">@context.RenderedMessage</MudText>
                                @if (!string.IsNullOrEmpty(context.Exception))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Color="Color.Error" Title="Has exception" />
                                }
                            </MudStack>
                        </MudTd>
                    </MudTr>
                    @if (_expandedLog == context)
                    {
                        <MudTr>
                            <MudTd colspan="4">
                                <MudPaper Elevation="0" Class="pa-3" Style="background:var(--mud-palette-background-gray)">
                                    <MudText Typo="Typo.subtitle2">Full Message</MudText>
                                    <pre style="white-space:pre-wrap;font-family:monospace;font-size:.8rem">@context.RenderedMessage</pre>
                                    @if (!string.IsNullOrEmpty(context.Exception))
                                    {
                                        <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mt-2">Exception</MudText>
                                        <pre style="white-space:pre-wrap;font-family:monospace;font-size:.8rem;color:var(--mud-palette-error)">@context.Exception</pre>
                                    }
                                    @if (context.Properties.Count > 0)
                                    {
                                        <MudText Typo="Typo.subtitle2" Class="mt-2">Properties</MudText>
                                        @foreach (var (key, val) in context.Properties)
                                        {
                                            <MudStack Row="true" Spacing="2">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="min-width:140px">@key</MudText>
                                                <MudText Typo="Typo.caption" Style="font-family:monospace">@val</MudText>
                                            </MudStack>
                                        }
                                    }
                                </MudPaper>
                            </MudTd>
                        </MudTr>
                    }
                </RowTemplate>
            </MudTable>

            @if (_result.TotalPages > 1)
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_result.TotalCount total entries</MudText>
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="PrevPage" Disabled="@(!_result.HasPreviousPage)">← Prev</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="NextPage" Disabled="@(!_result.HasNextPage)">Next →</MudButton>
                    </MudStack>
                </MudStack>
            }
        }
    </MudCardContent>
</MudCard>

@code {
    private LogFilter _filter = new();
    private PagedResult<LogEntry>? _result;
    private List<string> _sourceContexts = [];
    private bool _loading = true;
    private bool _liveMode = true;
    private LogEntry? _expandedLog;
    private CancellationTokenSource? _liveCts;
    private System.Threading.Timer? _debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadSourceContexts();
        await LoadLogs();
        if (_liveMode) StartLiveUpdates();
    }

    private async Task LoadLogs()
    {
        _loading = true;
        _result = await LogService.GetLogsAsync(_filter);
        _loading = false;
    }

    private async Task LoadSourceContexts()
    {
        _sourceContexts = await LogService.GetSourceContextsAsync();
    }

    private void OnFilterChanged(string? value)
    {
        _filter.SearchTerm = value;
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(_ => InvokeAsync(LoadLogs), null, 500, System.Threading.Timeout.Infinite);
    }

    private void ToggleLive()
    {
        _liveMode = !_liveMode;
        if (_liveMode) StartLiveUpdates();
        else
        {
            _liveCts?.Cancel();
            _liveCts = null;
        }
    }

    private void StartLiveUpdates()
    {
        _liveCts = new CancellationTokenSource();
        _ = LiveUpdateLoop(_liveCts.Token);
    }

    private async Task LiveUpdateLoop(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(2000, ct);
                await InvokeAsync(async () =>
                {
                    await LoadLogs();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { break; }
        }
    }

    private async Task Refresh()
    {
        await LoadSourceContexts();
        await LoadLogs();
    }

    private async Task ClearLogs()
    {
        await LogService.ClearLogsAsync();
        _result = PagedResult<LogEntry>.Empty(_filter.PageSize);
        Snackbar.Add("Logs cleared.", Severity.Success);
    }

    private void ExpandLog(LogEntry log)
    {
        _expandedLog = _expandedLog == log ? null : log;
    }

    private async Task PrevPage() { _filter.Page--; await LoadLogs(); }
    private async Task NextPage() { _filter.Page++; await LoadLogs(); }

    private static string ShortSource(string? source)
    {
        if (string.IsNullOrEmpty(source)) return "—";
        var parts = source.Split('.');
        return parts.Length > 2 ? $"...{parts[^1]}" : source;
    }

    private static Color LevelColor(LogLevel level) => level switch
    {
        LogLevel.Verbose => Color.Default,
        LogLevel.Debug   => Color.Default,
        LogLevel.Information => Color.Info,
        LogLevel.Warning => Color.Warning,
        LogLevel.Error   => Color.Error,
        LogLevel.Fatal   => Color.Error,
        _ => Color.Default
    };

    public async ValueTask DisposeAsync()
    {
        _liveCts?.Cancel();
        _debounceTimer?.Dispose();
        await ValueTask.CompletedTask;
    }
}
