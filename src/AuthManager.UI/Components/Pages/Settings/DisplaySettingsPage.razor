@page "/authmanager/settings"
@inject IEntityNamingService NamingService
@inject IRoleManagementService RoleService
@inject IAuditService AuditService
@inject IBrandingSettingsService BrandingService
@inject IOptions<AuthManagerOptions> Options
@inject ISnackbar Snackbar

<PageTitle>Display Settings — Auth Manager</PageTitle>

<div class="mb-4 am-page-header">
    <MudText Typo="Typo.h4">Display Settings</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        Customise how entities are labelled throughout the admin UI.
        Changes are persisted immediately and reflected on the next page load.
    </MudText>
</div>

<MudGrid Spacing="3">
    <MudItem xs="12" md="8">
        <MudStack Spacing="3">

            <!-- Entity Names -->
            <MudCard Elevation="0" Class="am-card-border">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">User Entity Name</MudText></CardHeaderContent>
                    <CardHeaderActions><MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Branding</MudChip></CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Rename the "User" concept to match your application domain —
                        "Member", "Customer", "Employee", "Player", etc.
                        The name is used in page titles, breadcrumbs, and button labels.
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_singular" Label="Singular Name" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Placeholder="User" MaxLength="32"
                                          HelperText="E.g. &quot;Member&quot;, &quot;Customer&quot;, &quot;Employee&quot;" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_plural" Label="Plural Name" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Placeholder="Users" MaxLength="32"
                                          HelperText="E.g. &quot;Members&quot;, &quot;Customers&quot;, &quot;Employees&quot;" />
                        </MudItem>
                    </MudGrid>

                    <MudAlert Severity="Severity.Normal" Class="mt-3">
                        Preview: <strong>@(_plural ?? "Users")</strong> list · Edit <strong>@(_singular ?? "User")</strong> · New <strong>@(_singular ?? "User")</strong>
                    </MudAlert>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveNaming" Disabled="_savingNaming">
                            @(_savingNaming ? "Saving…" : "Save Names")
                        </MudButton>
                        @if (_namingSaved)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Success">✓ Saved — reload to see changes in the sidebar</MudText>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>

            <!-- White-label Branding -->
            <MudCard Elevation="0" Class="am-card-border">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Branding</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Label this install as your own product — shown in the sidebar and setup wizard.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_branding.CompanyName" Label="Company / Product Name" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Placeholder="@Options.Value.Title"
                                          HelperText="Shown in the sidebar and page titles. Leave blank to use the startup title below." />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_branding.SupportEmail" Label="Support Email" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Placeholder="support@yourcompany.com" />
                        </MudItem>
                        <MudItem xs="12" sm="8">
                            <MudTextField @bind-Value="_branding.LogoUrl" Label="Logo URL" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Placeholder="https://yourcompany.com/logo.png"
                                          HelperText="Replaces the shield icon in the sidebar and setup wizard. Any size works." />
                        </MudItem>
                        <MudItem xs="12" sm="4" Class="d-flex align-center justify-center">
                            @if (!string.IsNullOrWhiteSpace(_branding.LogoUrl))
                            {
                                <img src="@_branding.LogoUrl" alt="Logo preview" style="max-width:64px;max-height:64px;object-fit:contain;border-radius:8px;" />
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">No logo set</MudText>
                            }
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                        <div>
                            <MudText Typo="Typo.body1">Hide "Powered by" footer</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Removes the DotNetAuthManager link from the setup wizard and version tag from the sidebar.</MudText>
                        </div>
                        <MudSwitch T="bool" @bind-Value="_branding.HidePoweredByFooter" Color="Color.Primary" />
                    </MudStack>

                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">
                        The startup title (<code>options.Title</code> in <code>Program.cs</code>, currently
                        <strong>@Options.Value.Title</strong>) is still used as the browser tab title and as the
                        Company Name fallback when that field above is left blank.
                    </MudText>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveBranding" Disabled="_savingBranding">
                            @(_savingBranding ? "Saving…" : "Save Branding")
                        </MudButton>
                        @if (_brandingSaved)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Success">✓ Saved — reload to see changes in the sidebar</MudText>
                        }
                    </MudStack>

                    <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                        Multi-tenant deployments can additionally override the company name and logo per
                        tenant on the <MudLink Href="/authmanager/tenants">Tenants</MudLink> dashboard —
                        this is the fallback shown when a tenant hasn't set its own.
                    </MudAlert>
                </MudCardContent>
            </MudCard>

            <!-- Default Role Names -->
            <MudCard Elevation="0" Class="am-card-border">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">Existing Roles</MudText></CardHeaderContent>
                    <CardHeaderActions><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_roles.Count total</MudChip></CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Roles are managed in the <MudLink Href="/authmanager/roles">Roles</MudLink> section.
                        To rename a role, edit it there. Below is a read-only overview.
                    </MudText>
                    @if (_roles.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No roles defined yet.</MudText>
                    }
                    else
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            @foreach (var role in _roles)
                            {
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined"
                                         Href="@($"/authmanager/roles/{role.Id}")">@role.Name</MudChip>
                            }
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>

            <!-- SuperAdmin Role Config -->
            <MudCard Elevation="0" Class="am-card-border">
                <MudCardHeader><MudText Typo="Typo.h6">Admin UI Access Role</MudText></MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Only users in this role can access the Auth Manager admin UI.
                        Change in <code>Program.cs</code>:
                    </MudText>
                    <MudTextField Value="@Options.Value.SuperAdminRole" Label="Current SuperAdmin Role" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" ReadOnly="true"
                                  HelperText="@($"options.SuperAdminRole = \"{Options.Value.SuperAdminRole}\";")" />
                </MudCardContent>
            </MudCard>
        </MudStack>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudStack Spacing="3">
            <MudCard Elevation="0" Class="am-card-border">
                <MudCardHeader><MudText Typo="Typo.h6">Quick Links</MudText></MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Text" FullWidth="true" Href="/authmanager/userfields"
                                   StartIcon="@Icons.Material.Filled.Label">Custom Field Definitions</MudButton>
                        <MudButton Variant="Variant.Text" FullWidth="true" Href="/authmanager/roles"
                                   StartIcon="@Icons.Material.Filled.Stars">Manage Roles</MudButton>
                        <MudButton Variant="Variant.Text" FullWidth="true" Href="/authmanager/security"
                                   StartIcon="@Icons.Material.Filled.Lock">Security Settings</MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="0" Class="am-card-border">
                <MudCardHeader><MudText Typo="Typo.h6">Startup Config</MudText></MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Some settings (title, SuperAdmin role) can only be changed in
                        <code>Program.cs</code> via <code>AddAuthManager(options =&gt; …)</code>
                        because they affect authentication at startup.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private string _singular = "User";
    private string _plural   = "Users";
    private bool _savingNaming;
    private bool _namingSaved;
    private List<RoleDto> _roles = [];

    private BrandingOptions _branding = new();
    private bool _savingBranding;
    private bool _brandingSaved;

    protected override async Task OnInitializedAsync()
    {
        _singular = NamingService.GetUserDisplayName();
        _plural   = NamingService.GetUsersDisplayName();

        _roles = await RoleService.GetRolesAsync();
        _branding = await BrandingService.GetSettingsAsync();
    }

    private async Task SaveBranding()
    {
        _savingBranding = true;
        await BrandingService.UpdateSettingsAsync(_branding);

        await AuditService.RecordAsync(new AuditEntry
        {
            Action     = "BrandingUpdated",
            EntityType = "DisplaySettings",
            EntityId   = "branding",
            NewValues  = new Dictionary<string, object?>
            {
                ["CompanyName"] = _branding.CompanyName,
                ["LogoUrl"] = _branding.LogoUrl,
                ["HidePoweredByFooter"] = _branding.HidePoweredByFooter,
            },
            Success = true
        });

        Snackbar.Add("Branding saved.", Severity.Success);
        _brandingSaved  = true;
        _savingBranding = false;
    }

    private async Task SaveNaming()
    {
        if (string.IsNullOrWhiteSpace(_singular)) _singular = "User";
        if (string.IsNullOrWhiteSpace(_plural))   _plural   = "Users";

        _savingNaming = true;
        await NamingService.SaveNamingAsync(_singular, _plural);

        await AuditService.RecordAsync(new AuditEntry
        {
            Action     = "EntityNamingUpdated",
            EntityType = "DisplaySettings",
            EntityId   = "entity_naming",
            NewValues  = new Dictionary<string, object?>
            {
                ["UserSingular"] = _singular,
                ["UserPlural"]   = _plural,
            },
            Success = true
        });

        Snackbar.Add("Display names saved.", Severity.Success);
        _namingSaved  = true;
        _savingNaming = false;
    }
}
