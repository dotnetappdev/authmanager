@page "/authmanager/tenants"
@using Microsoft.AspNetCore.Components.Authorization
@inject ITenantService TenantService
@inject ITenantFeatureService FeatureService
@inject IUserManagementService UserService
@inject ICustomerService CustomerService
@inject ISubscriptionService SubscriptionService
@inject IBrandingSettingsService BrandingService
@inject IOptions<AuthManagerOptions> Options
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Tenants — Auth Manager</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 am-page-header">
    <div>
        <MudText Typo="Typo.h4">Tenants</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            SuperAdmin control center — manage every tenant and customer, and toggle features per tenant.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.AddBusiness"
               OnClick="OpenCreate">
        New Tenant
    </MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <!-- ── KPI summary strip ─────────────────────────────────────────────── -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="6" sm="3">
            <MudCard Elevation="0" Class="am-card-border">
                <MudCardContent Class="pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.h4" Color="Color.Primary">@_tenants.Count(t => !t.IsRootTenant)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">Tenants</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Elevation="0" Class="am-card-border">
                <MudCardContent Class="pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.h4" Color="Color.Info">@_totalUsers</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">Users</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Elevation="0" Class="am-card-border">
                <MudCardContent Class="pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.h4" Color="Color.Success">@_totalCustomers</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">Customers</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Elevation="0" Class="am-card-border">
                <MudCardContent Class="pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.h4" Color="Color.Warning">@_activeSubscriptions</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">Active Subscriptions</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (!_isSuperAdmin)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
            Signed in as Admin — tenant branding and feature-flag controls are SuperAdmin-only. You can still create, rename, and manage members.
        </MudAlert>
    }

    <MudGrid Spacing="3">
        @foreach (var tenant in _tenants)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            @if (!string.IsNullOrWhiteSpace(tenant.BrandingLogoUrl))
                            {
                                <MudAvatar Size="Size.Medium"><MudImage Src="@tenant.BrandingLogoUrl" ObjectFit="ObjectFit.Cover" /></MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Color="@(tenant.IsRootTenant ? Color.Secondary : Color.Primary)" Size="Size.Medium">
                                    <MudIcon Icon="@(tenant.IsRootTenant ? Icons.Material.Filled.Public : Icons.Material.Filled.Business)" />
                                </MudAvatar>
                            }
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Class="font-weight-medium">@(tenant.BrandingCompanyName ?? tenant.DisplayName)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@(tenant.IsRootTenant ? "no tenant claim" : tenant.Id)</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (!tenant.IsRootTenant)
                            {
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small">
                                    <MudMenuItem OnClick="@(() => OpenEdit(tenant))">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-2" />Manage
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="@(() => OpenMembers(tenant))">
                                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-2" />Members
                                    </MudMenuItem>
                                    <MudDivider />
                                    <MudMenuItem OnClick="@(() => DeleteTenant(tenant))" Style="color:var(--mud-palette-error)">
                                        <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-2" />Delete
                                    </MudMenuItem>
                                </MudMenu>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.People" Size="Size.Small"
                                               Title="View members" OnClick="@(() => OpenMembers(tenant))" />
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pt-0">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @tenant.MemberCount member@(tenant.MemberCount == 1 ? "" : "s")
                            </MudText>
                        </MudStack>
                        @if (!tenant.IsRootTenant && tenant.FeatureOverrides.Count > 0)
                        {
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                                @foreach (var (feature, enabled) in tenant.FeatureOverrides)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@(enabled ? Color.Success : Color.Error)">
                                        @feature: @(enabled ? "On" : "Off")
                                    </MudChip>
                                }
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<!-- ── Create / Manage Dialog ────────────────────────────────────────────── -->
<MudDialog @bind-IsVisible="_showDialog" Options="_dialogOpts">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingTenant is null ? "New Tenant" : $"Manage — {_editingTenant.DisplayName}")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_editingTenant is null)
        {
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_form.Id" Label="Tenant ID" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Placeholder="e.g. acme-corp" Required="true"
                              HelperText="Stable identifier stored in the tenant claim — cannot be changed later" />
                <MudTextField @bind-Value="_form.DisplayName" Label="Display Name" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Placeholder="e.g. Acme Corp" Required="true" />
            </MudStack>
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true">
                <MudTabPanel Text="General">
                    <MudStack Spacing="3" Class="pa-2">
                        <MudTextField @bind-Value="_form.DisplayName" Label="Display Name" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Required="true" />
                    </MudStack>
                </MudTabPanel>
                <MudTabPanel Text="Branding">
                    <MudStack Spacing="3" Class="pa-2">
                        <MudTextField @bind-Value="_form.BrandingCompanyName" Label="Company Name Override" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Placeholder="@(_globalBrandName)"
                                      HelperText="Leave blank to use the global branding shown on Display Settings." />
                        <MudTextField @bind-Value="_form.BrandingLogoUrl" Label="Logo URL Override" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Placeholder="https://tenant.example.com/logo.png"
                                      HelperText="Leave blank to use the global logo." />
                        @if (!string.IsNullOrWhiteSpace(_form.BrandingLogoUrl))
                        {
                            <img src="@_form.BrandingLogoUrl" alt="Logo preview" style="max-width:64px;max-height:64px;object-fit:contain;border-radius:8px;" />
                        }
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Branding overrides are exposed via <code>ITenantService</code>/the REST API for your
                            own tenant-facing pages (e.g. a per-tenant login screen) — they don't change
                            AuthManager's own admin UI, which stays on the global branding.
                        </MudAlert>
                    </MudStack>
                </MudTabPanel>
                <MudTabPanel Text="Feature Flags">
                    @if (!_isSuperAdmin)
                    {
                        <MudAlert Severity="Severity.Warning" Class="ma-2">SuperAdmin access required to change feature flags.</MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="2" Class="pa-2">
                            @foreach (var feature in _allFeatures)
                            {
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <div>
                                        <MudText Typo="Typo.body2">@feature</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Effective: @(_effectiveFlags.GetValueOrDefault(feature) ? "Enabled" : "Disabled")
                                        </MudText>
                                    </div>
                                    <MudSelect T="string" Value="@_featureStates.GetValueOrDefault(feature, "inherit")"
                                               ValueChanged="@(v => _featureStates[feature] = v)"
                                               Dense="true" Margin="Margin.Dense" Style="max-width:180px">
                                        <MudSelectItem T="string" Value="@("inherit")">Inherit default</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("enabled")">Force Enabled</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("disabled")">Force Disabled</MudSelectItem>
                                    </MudSelect>
                                </MudStack>
                                <MudDivider />
                            }
                        </MudStack>
                    }
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDialog = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveTenant" Disabled="_saving">
            @(_saving ? "Saving…" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- ── Members Dialog ────────────────────────────────────────────────────── -->
<MudDialog @bind-IsVisible="_showMembers" Options="_dialogOpts">
    <TitleContent>
        <MudText Typo="Typo.h6">Members — @_membersTenant?.DisplayName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_membersLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            @if (_membersTenant is { IsRootTenant: false })
            {
                <MudStack Row="true" Spacing="2" Class="mb-3">
                    <MudTextField @bind-Value="_addUserQuery" Label="Add user by username or email"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddMember">Add</MudButton>
                </MudStack>
            }

            @if (!_members.Any())
            {
                <MudAlert Severity="Severity.Info">No members yet.</MudAlert>
            }
            else
            {
                <MudList T="UserDto" Dense="true">
                    @foreach (var m in _members)
                    {
                        <MudListItem T="UserDto" Value="m">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Primary" Size="Size.Small">@m.UserName[..1].ToUpper()</MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body2">@m.UserName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@m.Email</MudText>
                                </div>
                                <MudSpacer />
                                @if (_membersTenant is { IsRootTenant: false })
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                   Size="Size.Small" Color="Color.Error"
                                                   Title="Remove from tenant"
                                                   OnClick="@(() => RemoveMember(m))" />
                                }
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showMembers = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<TenantDto> _tenants = [];
    private List<UserDto>   _members = [];
    private bool _loading = true;
    private bool _saving;
    private bool _showDialog;
    private bool _showMembers;
    private bool _membersLoading;
    private bool _isSuperAdmin;
    private string _addUserQuery = "";
    private TenantDto? _editingTenant;
    private TenantDto? _membersTenant;
    private readonly TenantFormModel _form = new();

    private int _totalUsers;
    private int _totalCustomers;
    private int _activeSubscriptions;
    private string _globalBrandName = "";

    private static readonly TenantFeature[] _allFeatures = Enum.GetValues<TenantFeature>();
    private Dictionary<TenantFeature, string> _featureStates = [];
    private Dictionary<TenantFeature, bool> _effectiveFlags = [];

    private static readonly DialogOptions _dialogOpts = new()
        { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _isSuperAdmin = authState.User.IsInRole(Options.Value.SuperAdminRole);

        await Reload();

        var customers = await CustomerService.GetCustomersAsync();
        _totalCustomers = customers.Count;
        var subscriptions = await SubscriptionService.GetSubscriptionsAsync();
        _activeSubscriptions = subscriptions.Count(s => s.Status is SubscriptionStatus.Active or SubscriptionStatus.Trialing);

        var branding = await BrandingService.GetSettingsAsync();
        _globalBrandName = string.IsNullOrWhiteSpace(branding.CompanyName) ? Options.Value.Title : branding.CompanyName;

        _loading = false;
    }

    private async Task Reload()
    {
        _tenants = await TenantService.GetTenantsAsync();
        _totalUsers = _tenants.Sum(t => t.MemberCount);
    }

    private void OpenCreate()
    {
        _editingTenant  = null;
        _form.Id          = "";
        _form.DisplayName = "";
        _form.BrandingCompanyName = null;
        _form.BrandingLogoUrl = null;
        _featureStates = [];
        _showDialog       = true;
    }

    private async Task OpenEdit(TenantDto tenant)
    {
        _editingTenant    = tenant;
        _form.Id          = tenant.Id;
        _form.DisplayName = tenant.DisplayName;
        _form.BrandingCompanyName = tenant.BrandingCompanyName;
        _form.BrandingLogoUrl = tenant.BrandingLogoUrl;

        _featureStates = [];
        foreach (var (feature, enabled) in tenant.FeatureOverrides)
            _featureStates[feature] = enabled ? "enabled" : "disabled";

        _effectiveFlags = await FeatureService.GetEffectiveFlagsAsync(tenant.Id);
        _showDialog = true;
    }

    private async Task OpenMembers(TenantDto tenant)
    {
        _membersTenant  = tenant;
        _showMembers    = true;
        _membersLoading = true;
        _addUserQuery   = "";
        _members = await TenantService.GetTenantMembersAsync(tenant.Id);
        _membersLoading = false;
    }

    private async Task SaveTenant()
    {
        _saving = true;
        (bool ok, string[] errors) result;

        if (_editingTenant is null)
        {
            result = await TenantService.CreateTenantAsync(new CreateTenantDto
                { Id = _form.Id, DisplayName = _form.DisplayName });
        }
        else
        {
            var overrides = new Dictionary<TenantFeature, bool>();
            if (_isSuperAdmin)
            {
                foreach (var (feature, state) in _featureStates)
                {
                    if (state == "enabled") overrides[feature] = true;
                    else if (state == "disabled") overrides[feature] = false;
                }
            }
            else
            {
                // Not SuperAdmin — leave whatever overrides already existed on the tenant untouched.
                overrides = _editingTenant.FeatureOverrides;
            }

            result = await TenantService.UpdateTenantAsync(_editingTenant.Id, new UpdateTenantDto
            {
                DisplayName = _form.DisplayName,
                BrandingCompanyName = _form.BrandingCompanyName,
                BrandingLogoUrl = _form.BrandingLogoUrl,
                FeatureOverrides = overrides,
            });
        }

        _saving = false;
        if (result.ok)
        {
            _showDialog = false;
            Snackbar.Add(_editingTenant is null ? "Tenant created." : "Tenant updated.", Severity.Success);
            await Reload();
        }
        else
        {
            foreach (var e in result.errors)
                Snackbar.Add(e, Severity.Error);
        }
    }

    private async Task DeleteTenant(TenantDto tenant)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Delete Tenant",
            $"Delete '{tenant.DisplayName}'? Members will not be deleted, but will lose their tenant claim.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirm != true) return;

        var (ok, errors) = await TenantService.DeleteTenantAsync(tenant.Id);
        if (ok) { Snackbar.Add("Tenant deleted.", Severity.Success); await Reload(); }
        else    foreach (var e in errors) Snackbar.Add(e, Severity.Error);
    }

    private async Task AddMember()
    {
        if (_membersTenant is null || string.IsNullOrWhiteSpace(_addUserQuery)) return;

        var user = _addUserQuery.Contains('@')
            ? await UserService.GetUserByEmailAsync(_addUserQuery.Trim())
            : await UserService.GetUserByUserNameAsync(_addUserQuery.Trim());

        if (user is null)
        {
            Snackbar.Add("No user found with that username or email.", Severity.Error);
            return;
        }

        var (ok, errors) = await TenantService.AssignUserToTenantAsync(user.Id, _membersTenant.Id);
        if (ok)
        {
            Snackbar.Add($"{user.UserName} added to {_membersTenant.DisplayName}.", Severity.Success);
            _addUserQuery = "";
            _members = await TenantService.GetTenantMembersAsync(_membersTenant.Id);
            await Reload();
        }
        else
        {
            foreach (var e in errors) Snackbar.Add(e, Severity.Error);
        }
    }

    private async Task RemoveMember(UserDto user)
    {
        if (_membersTenant is null) return;
        await TenantService.RemoveUserFromTenantAsync(user.Id);
        _members.Remove(user);
        Snackbar.Add($"{user.UserName} removed from tenant.", Severity.Success);
        await Reload();
    }

    private sealed class TenantFormModel
    {
        public string Id          { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string? BrandingCompanyName { get; set; }
        public string? BrandingLogoUrl { get; set; }
    }
}
