@page "/authmanager/jwt"
@inject IJwtConfigService JwtService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>JWT Settings — Auth Manager</PageTitle>

<div class="mb-4 am-page-header">
    <MudText Typo="Typo.h4">JWT Configuration</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">Manage JSON Web Token settings for API authentication</MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_config != null)
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudStack Spacing="3">
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">Token Settings</MudText></MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_config.Issuer" Label="Issuer" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Placeholder="https://your-api.com"
                                              HelperText="The authority that issues the token (iss claim)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_config.Audience" Label="Audience" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Placeholder="https://your-api.com/api"
                                              HelperText="The intended recipient of the token (aud claim)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" @bind-Value="_config.Algorithm" Label="Algorithm" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="string" Value="@("HS256")">HS256 (HMAC-SHA256)</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("HS384")">HS384 (HMAC-SHA384)</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("HS512")">HS512 (HMAC-SHA512)</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("RS256")">RS256 (RSA-SHA256)</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_config.AccessTokenExpiryMinutes" Label="Access Token Expiry (minutes)"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="1440" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_config.RefreshTokenExpiryDays" Label="Refresh Token Expiry (days)"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="365" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">Validation Options</MudText></MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Enable Refresh Tokens</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Allow clients to request new access tokens without re-authentication</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_config.EnableRefreshTokens" Color="Color.Primary" />
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Validate Issuer</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Verify the iss claim matches the configured issuer</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_config.ValidateIssuer" Color="Color.Primary" />
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Validate Audience</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Verify the aud claim matches the configured audience</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_config.ValidateAudience" Color="Color.Primary" />
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Validate Lifetime</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Reject expired tokens</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_config.ValidateLifetime" Color="Color.Primary" />
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Require HTTPS Metadata</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Require HTTPS for the metadata endpoint</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_config.RequireHttpsMetadata" Color="Color.Primary" />
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">Test Token Generator</MudText></MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            Generate a test JWT for debugging. Never use test tokens in production.
                        </MudText>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                            <MudTextField @bind-Value="_testUserId" Label="User ID" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Placeholder="Enter user ID or sub claim..." Class="flex-grow-1" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateToken"
                                       Disabled="@string.IsNullOrEmpty(_testUserId)" Class="mt-1">Generate</MudButton>
                        </MudStack>
                        @if (!string.IsNullOrEmpty(_testToken))
                        {
                            <MudPaper Elevation="0" Class="am-card-border pa-3 mt-3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Generated Token:</MudText>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Style="font-family:monospace;word-break:break-all;flex:1">@_testToken</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Title="Copy" OnClick="CopyToken" />
                                </MudStack>
                            </MudPaper>
                        }
                    </MudCardContent>
                </MudCard>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="3">
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">Signing Key</MudText></MudCardHeader>
                    <MudCardContent>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.VpnKey" Color="Color.Primary" />
                            <div>
                                <MudText Typo="Typo.body2" Style="font-family:monospace">@_config.SigningKeyPreview</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Algorithm: @_config.Algorithm</MudText>
                            </div>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                            Configure signing keys via environment variables or appsettings.json for security.
                        </MudText>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardContent>
                        @if (_errors.Length > 0)
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">@string.Join(", ", _errors)</MudAlert>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Save" Disabled="_saving">
                            @(_saving ? "Saving…" : "Save Configuration")
                        </MudButton>
                    </MudCardContent>
                </MudCard>
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private JwtConfigInfo? _config;
    private bool _loading = true;
    private bool _saving;
    private string[] _errors = [];
    private string _testUserId = "";
    private string _testToken = "";

    protected override async Task OnInitializedAsync()
    {
        _config = await JwtService.GetConfigAsync();
        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _errors = [];
        var (success, errors) = await JwtService.UpdateConfigAsync(_config!);
        if (success)
            Snackbar.Add("JWT configuration saved.", Severity.Success);
        else
            _errors = errors;
        _saving = false;
    }

    private async Task GenerateToken()
    {
        _testToken = await JwtService.GenerateTestTokenAsync(_testUserId);
    }

    private async Task CopyToken()
    {
        await JS.InvokeVoidAsync("authManager.copyToClipboard", _testToken);
        Snackbar.Add("Token copied to clipboard.", Severity.Success);
    }
}
