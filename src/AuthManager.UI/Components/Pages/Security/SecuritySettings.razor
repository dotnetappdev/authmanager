@page "/authmanager/security"
@rendermode InteractiveServer
@inject ISecurityPolicyService SecurityService
@inject IAuditService AuditService
@inject IOptions<AuthManagerOptions> Options
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Security Settings — Auth Manager</PageTitle>

<div class="mb-4">
    <MudText Typo="Typo.h4">Security Settings</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">Configure password policy, brute-force protection, database storage, and appearance.</MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudStack Spacing="3">

                <!-- Password Policy -->
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Password Policy</MudText></CardHeaderContent>
                        <CardHeaderActions><MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">ASP.NET Identity</MudChip></CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_pw.MinimumLength" Label="Minimum Length" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Min="4" Max="128"
                                                 HelperText="Minimum number of characters required (default: 8)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_pw.MaximumLength" Label="Maximum Length" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Min="8" Max="256"
                                                 HelperText="Prevents DoS via bcrypt — keep ≤ 128 (default: 128)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_pw.PasswordHistoryCount" Label="Password History (last N)" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Min="0" Max="24"
                                                 HelperText="Reject if the password matches a recent one. 0 = disabled" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_pw.PasswordExpiryDays" Label="Password Expiry (days)" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Min="0" Max="365"
                                                 HelperText="Force password change after N days. 0 = never expires" />
                            </MudItem>
                        </MudGrid>

                        <MudStack Spacing="1" Class="mt-4">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Require Uppercase Letter (A–Z)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Password must contain at least one uppercase character</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_pw.RequireUppercase" Color="Color.Primary" />
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Require Lowercase Letter (a–z)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Password must contain at least one lowercase character</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_pw.RequireLowercase" Color="Color.Primary" />
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Require Digit (0–9)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Password must contain at least one numeric digit</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_pw.RequireDigit" Color="Color.Primary" />
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Require Non-Alphanumeric (!, @@, #…)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Password must contain at least one special character</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_pw.RequireNonAlphanumeric" Color="Color.Primary" />
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Deny Username in Password</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Reject passwords that contain the user's username</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_pw.DenyUsernameInPassword" Color="Color.Primary" />
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>

                <!-- Brute Force / Lockout -->
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Brute Force Detection</MudText></CardHeaderContent>
                        <CardHeaderActions><MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Account Lockout</MudChip></CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div>
                                <MudText Typo="Typo.body1">Enable Brute Force Detection</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Temporarily lock accounts after repeated failed login attempts</MudText>
                            </div>
                            <MudSwitch T="bool" @bind-Value="_sec.EnableBruteForceDetection" Color="Color.Primary" />
                        </MudStack>

                        <MudGrid Class="mt-2">
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_sec.MaxFailedLoginAttempts" Label="Max Failed Attempts" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Min="1" Max="20" Disabled="!_sec.EnableBruteForceDetection"
                                                 HelperText="Failed logins before the account is locked (default: 5)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_lockoutMinutes" Label="Lockout Duration (minutes)" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Min="1" Max="10080" Disabled="!_sec.EnableBruteForceDetection"
                                                 HelperText="How long the account stays locked (default: 15 min)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_failedAttemptWindowHours" Label="Failed Attempt Window (hours)" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Min="1" Max="168" Disabled="!_sec.EnableBruteForceDetection"
                                                 HelperText="Reset failure count after this idle period (default: 12 h)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_sec.MaxConcurrentSessions" Label="Max Concurrent Sessions Per User" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Min="0" Max="100"
                                                 HelperText="0 = unlimited. Oldest session terminated when exceeded" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_secStampMinutes" Label="Security Stamp Validation (minutes)" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Min="1" Max="1440"
                                                 HelperText="How often cookie auth re-validates against the server (default: 30 min)" />
                            </MudItem>
                        </MudGrid>

                        <MudStack Spacing="1" Class="mt-4">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Invalidate Sessions on Password Change</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Force re-login on all devices when a user changes their password</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_sec.InvalidateSessionsOnPasswordChange" Color="Color.Primary" />
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Enable Refresh Token Rotation</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Issue a new refresh token on each use and invalidate the old one</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_sec.EnableRefreshTokenRotation" Color="Color.Primary" />
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>

                <!-- Registration -->
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">Registration Policy</MudText></MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Allow Self-Registration</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Allow new users to register themselves via the standard Identity flows</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_sec.AllowSelfRegistration" Color="Color.Primary" />
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Require Email Verification on Registration</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">New accounts must verify their email before they can sign in</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_sec.RequireEmailVerificationOnRegistration" Color="Color.Primary" />
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>

                <!-- Database & Storage -->
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Database &amp; Storage</MudText></CardHeaderContent>
                        <CardHeaderActions><MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Internal DB</MudChip></CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            AuthManager keeps its own internal database for audit entries, session records, and settings
                            overrides — separate from your application's database. <strong>SQLite</strong> is the default
                            and requires no external server. Switch to <strong>SQL Server</strong> for enterprise
                            or clustered deployments.
                        </MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" @bind-Value="_dbProvider" Label="Database Provider" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           HelperText="Changes take effect after saving and restarting the application">
                                    <MudSelectItem T="string" Value="@("SQLite")">SQLite (default — no install needed)</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("SqlServer")">SQL Server</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_dbConnectionString" Label="Connection String" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Placeholder="@DbPlaceholder"
                                              HelperText="@(_dbProvider == "SQLite" ? "SQLite file path — relative to the application working directory" : "SQL Server connection string. Use (localdb)\\mssqllocaldb for local development")" />
                            </MudItem>
                        </MudGrid>
                        <MudAlert Severity="Severity.Warning" Class="mt-3">
                            <strong>Note:</strong> Changing the provider or connection string requires an application restart
                            to take effect. Existing data will not be migrated automatically.
                        </MudAlert>
                    </MudCardContent>
                </MudCard>

                <!-- Appearance -->
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Appearance</MudText></CardHeaderContent>
                        <CardHeaderActions><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Theme</MudChip></CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            Choose the colour scheme for the Auth Manager UI. Your preference is saved in the browser
                            and overrides the server-side default. Use the toggle in the sidebar footer to switch on the fly.
                        </MudText>
                        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
                            <MudButton Variant="@(_currentTheme == "dark" ? Variant.Filled : Variant.Outlined)"
                                       StartIcon="@Icons.Material.Filled.DarkMode" OnClick='@(() => SetTheme("dark"))'>Dark</MudButton>
                            <MudButton Variant="@(_currentTheme == "light" ? Variant.Filled : Variant.Outlined)"
                                       StartIcon="@Icons.Material.Filled.LightMode" OnClick='@(() => SetTheme("light"))'>Light</MudButton>
                            <MudButton Variant="@(_currentTheme == "high-contrast" ? Variant.Filled : Variant.Outlined)"
                                       StartIcon="@Icons.Material.Filled.Contrast" OnClick='@(() => SetTheme("high-contrast"))'>High Contrast</MudButton>
                            <MudButton Variant="@(_currentTheme == "system" ? Variant.Filled : Variant.Outlined)"
                                       StartIcon="@Icons.Material.Filled.Computer" OnClick='@(() => SetTheme("system"))'>System</MudButton>
                        </MudButtonGroup>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                            Current: <strong>@(_currentTheme switch { "system" => "System default", "dark" => "Dark mode", "high-contrast" => "High Contrast", _ => "Light mode" })</strong>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                            Takes effect on the next page load.
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="3">
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">Save Changes</MudText></MudCardHeader>
                    <MudCardContent>
                        @if (_saved)
                        {
                            <MudAlert Severity="Severity.Success" Class="mb-3">Settings saved successfully.</MudAlert>
                        }
                        @if (_errors.Length > 0)
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">@string.Join(", ", _errors)</MudAlert>
                        }
                        <MudStack Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SaveAll" Disabled="_saving">
                                @(_saving ? "Saving…" : "Save All Settings")
                            </MudButton>
                            <MudButton Variant="Variant.Text" FullWidth="true" OnClick="ResetDefaults">
                                Reset to Defaults
                            </MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">About</MudText></MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Password policy changes take effect on the <strong>next password creation or reset</strong>.
                            Existing passwords are not affected.
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                            Lockout settings are applied to <strong>ASP.NET Identity's LockoutOptions</strong>.
                            Runtime changes are persisted to the internal database and apply immediately.
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                            Database provider changes require an <strong>application restart</strong> to take effect.
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private PasswordPolicyOptions _pw = new();
    private SecurityPolicyOptions _sec = new();
    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string[] _errors = [];

    // DB settings — read from options, editable here
    private string _dbProvider         = "SQLite";
    private string _dbConnectionString = "Data Source=authmanager.db";

    private string DbPlaceholder => _dbProvider == "SQLite"
        ? "Data Source=authmanager.db"
        : "Server=.;Database=AuthManager;Trusted_Connection=true";

    // Theme — loaded from JS localStorage
    private string _currentTheme = "system";

    // Bridge TimeSpan ↔ numeric form fields
    private int _lockoutMinutes
    {
        get => (int)_sec.LockoutDuration.TotalMinutes;
        set => _sec.LockoutDuration = TimeSpan.FromMinutes(value);
    }
    private int _failedAttemptWindowHours
    {
        get => (int)_sec.FailedAttemptWindow.TotalHours;
        set => _sec.FailedAttemptWindow = TimeSpan.FromHours(value);
    }
    private int _secStampMinutes
    {
        get => (int)_sec.SecurityStampValidationInterval.TotalMinutes;
        set => _sec.SecurityStampValidationInterval = TimeSpan.FromMinutes(value);
    }

    protected override Task OnInitializedAsync()
    {
        _pw  = SecurityService.GetPasswordPolicy();
        _sec = SecurityService.GetSecurityPolicy();

        var opts          = Options.Value;
        _dbProvider       = opts.InternalDatabaseProvider;
        _dbConnectionString = opts.InternalDatabaseConnectionString;

        _loading = false;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _currentTheme = await JS.InvokeAsync<string?>("authManager.getTheme") ?? "system";
            StateHasChanged();
        }
    }

    private async Task SetTheme(string theme)
    {
        _currentTheme = theme;
        if (theme == "system")
            await JS.InvokeVoidAsync("authManager.clearTheme");
        else
            await JS.InvokeVoidAsync("authManager.setTheme", theme);
        StateHasChanged();
    }

    private async Task SaveAll()
    {
        _saving = true;
        _saved  = false;
        _errors = [];

        try
        {
            await SecurityService.UpdatePasswordPolicyAsync(_pw);
            await SecurityService.UpdateSecurityPolicyAsync(_sec);

            await AuditService.RecordAsync(new AuditEntry
            {
                Action    = AuditActions.PasswordPolicyUpdated,
                EntityType = "SecuritySettings",
                EntityId   = "password_policy",
                NewValues  = new Dictionary<string, object?>
                {
                    ["MinimumLength"]          = _pw.MinimumLength,
                    ["RequireUppercase"]       = _pw.RequireUppercase,
                    ["RequireLowercase"]       = _pw.RequireLowercase,
                    ["RequireDigit"]           = _pw.RequireDigit,
                    ["RequireNonAlphanumeric"] = _pw.RequireNonAlphanumeric,
                    ["PasswordHistoryCount"]   = _pw.PasswordHistoryCount,
                    ["PasswordExpiryDays"]     = _pw.PasswordExpiryDays,
                },
                Success = true
            });

            await AuditService.RecordAsync(new AuditEntry
            {
                Action    = AuditActions.SecurityPolicyUpdated,
                EntityType = "SecuritySettings",
                EntityId   = "security_policy",
                NewValues  = new Dictionary<string, object?>
                {
                    ["EnableBruteForceDetection"] = _sec.EnableBruteForceDetection,
                    ["MaxFailedLoginAttempts"]     = _sec.MaxFailedLoginAttempts,
                    ["LockoutDurationMinutes"]     = _lockoutMinutes,
                    ["MaxConcurrentSessions"]      = _sec.MaxConcurrentSessions,
                    ["DatabaseProvider"]           = _dbProvider,
                },
                Success = true
            });

            Snackbar.Add("Security settings saved. Restart the app to apply database changes.", Severity.Success);
            _saved = true;
        }
        catch (Exception ex)
        {
            _errors = [ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetDefaults()
    {
        _pw  = new PasswordPolicyOptions();
        _sec = new SecurityPolicyOptions();
        _dbProvider         = "SQLite";
        _dbConnectionString = "Data Source=authmanager.db";
        _saved = false;
        _errors = [];
        Snackbar.Add("Defaults loaded. Click Save to apply.", Severity.Info);
    }
}
