@page "/authmanager/roles/create"
@page "/authmanager/roles/{RoleId}"
@inject IRoleManagementService RoleService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(IsCreate ? "Create Role" : "Edit Role") — Auth Manager</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 am-page-header">
    <div>
        <MudLink Href="/authmanager/roles" Underline="Underline.Hover" Class="mb-1 d-block">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mr-1" Style="vertical-align:middle" />Back to Roles
        </MudLink>
        <MudText Typo="Typo.h4">@(IsCreate ? "Create New Role" : $"Edit Role: {_role?.Name}")</MudText>
    </div>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudCard Elevation="0" Class="am-card-border mb-4">
                <MudCardHeader><MudText Typo="Typo.h6">Role Details</MudText></MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="3">
                        <MudTextField @bind-Value="_name" Label="Role Name" Required="true" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Placeholder="e.g. Admin, Manager, Viewer"
                                      HelperText="Use PascalCase. Cannot be changed after creation." Disabled="!IsCreate" />
                        <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Lines="3" Placeholder="Describe what this role can do..." />
                    </MudStack>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="0" Class="am-card-border">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">Role Claims</MudText></CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddClaim">
                            Add Claim
                        </MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Claims attached to this role will be automatically applied to all users who have the role.
                    </MudText>
                    @if (_claims.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No claims. Click "Add Claim" to add one.</MudText>
                    }
                    <MudStack Spacing="2">
                        @foreach (var (claim, index) in _claims.Select((c, i) => (c, i)))
                        {
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudTextField T="string" @bind-Value="claim.Type" Label="Type" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Placeholder="permission" />
                                <MudTextField T="string" @bind-Value="claim.Value" Label="Value" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Placeholder="read:users" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => RemoveClaim(index))" />
                            </MudStack>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="0" Class="am-card-border">
                <MudCardContent>
                    @if (_errors.Length > 0)
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3">
                            @foreach (var err in _errors)
                            {
                                <div>@err</div>
                            }
                        </MudAlert>
                    }
                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="Save" Disabled="_saving">
                            @(_saving ? "Saving…" : (IsCreate ? "Create Role" : "Save Changes"))
                        </MudButton>
                        <MudButton Variant="Variant.Text" FullWidth="true" Href="/authmanager/roles">
                            Cancel
                        </MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string? RoleId { get; set; }

    private bool IsCreate => string.IsNullOrEmpty(RoleId);
    private RoleDto? _role;
    private string _name = "";
    private string? _description;
    private List<ClaimDto> _claims = [];
    private bool _loading = true;
    private bool _saving;
    private string[] _errors = [];

    protected override async Task OnInitializedAsync()
    {
        if (!IsCreate)
        {
            _role = await RoleService.GetRoleByIdAsync(RoleId!);
            if (_role != null)
            {
                _name = _role.Name;
                _description = _role.Description;
                _claims = _role.Claims.ToList();
            }
        }
        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _errors = [];
        try
        {
            bool success;
            string[] errors;

            if (IsCreate)
            {
                (success, errors) = await RoleService.CreateRoleAsync(new CreateRoleDto
                {
                    Name = _name,
                    Description = _description,
                    Claims = _claims
                });
            }
            else
            {
                (success, errors) = await RoleService.UpdateRoleAsync(new UpdateRoleDto
                {
                    Id = RoleId!,
                    Name = _name,
                    Description = _description
                });
            }

            if (success)
            {
                Snackbar.Add(IsCreate ? $"Role \"{_name}\" created." : "Role updated.", Severity.Success);
                Nav.NavigateTo("/authmanager/roles");
            }
            else
            {
                _errors = errors;
            }
        }
        finally { _saving = false; }
    }

    private void AddClaim() => _claims.Add(new ClaimDto());
    private void RemoveClaim(int index) => _claims.RemoveAt(index);
}
