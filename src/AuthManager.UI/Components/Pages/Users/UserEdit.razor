@page "/authmanager/users/create"
@page "/authmanager/users/{UserId}"
@rendermode InteractiveServer
@inject IUserManagementService UserService
@inject IRoleManagementService RoleService
@inject IUserFieldService FieldService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(IsCreate ? "Create User" : "Edit User") — Auth Manager</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudLink Href="/authmanager/users" Underline="Underline.Hover" Class="mb-1 d-block">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mr-1" Style="vertical-align:middle" />Back to Users
        </MudLink>
        <MudText Typo="Typo.h4">@(IsCreate ? "Create New User" : $"Edit: {_user?.UserName}")</MudText>
    </div>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudStack Spacing="3">

                <!-- Basic Info -->
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">Basic Information</MudText></MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_form.UserName" Label="Username" Required="true"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="username" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_form.Email" Label="Email" Required="true" InputType="InputType.Email"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="user@example.com" />
                            </MudItem>
                            @if (IsCreate)
                            {
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_form.Password" Label="Password" Required="true" InputType="InputType.Password"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="••••••••" />
                                </MudItem>
                            }
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_form.PhoneNumber" Label="Phone Number" InputType="InputType.Telephone"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="+1 (555) 000-0000" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <!-- Settings -->
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">Account Settings</MudText></MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1">Email Confirmed</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Mark email as verified without sending confirmation</MudText>
                                </div>
                                <MudSwitch T="bool" @bind-Value="_form.EmailConfirmed" Color="Color.Primary" />
                            </MudStack>
                            @if (!IsCreate)
                            {
                                <MudDivider />
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <div>
                                        <MudText Typo="Typo.body1">Two-Factor Authentication</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Require 2FA for this user</MudText>
                                    </div>
                                    <MudSwitch T="bool" @bind-Value="_updateForm.TwoFactorEnabled" Color="Color.Primary" />
                                </MudStack>
                                <MudDivider />
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <div>
                                        <MudText Typo="Typo.body1">Lockout Enabled</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Allow this account to be locked after failed attempts</MudText>
                                    </div>
                                    <MudSwitch T="bool" @bind-Value="_updateForm.LockoutEnabled" Color="Color.Primary" />
                                </MudStack>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>

                <!-- Password Reset (edit mode only) -->
                @if (!IsCreate)
                {
                    <MudCard Elevation="0" Class="am-card-border">
                        <MudCardHeader><MudText Typo="Typo.h6">Reset Password</MudText></MudCardHeader>
                        <MudCardContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                                <MudTextField @bind-Value="_newPassword" Label="New Password" InputType="InputType.Password"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Enter new password" Class="flex-grow-1" />
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ResetPassword"
                                           Disabled="@string.IsNullOrEmpty(_newPassword)" Class="mt-1">
                                    Reset Password
                                </MudButton>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                }

                <!-- Required Actions (edit mode only) -->
                @if (!IsCreate)
                {
                    <MudCard Elevation="0" Class="am-card-border">
                        <MudCardHeader>
                            <CardHeaderContent><MudText Typo="Typo.h6">Required Actions</MudText></CardHeaderContent>
                            <CardHeaderActions><MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Enforced on next sign-in</MudChip></CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Assign actions the user <strong>must complete</strong> the next time they sign in —
                                per-user actions enforced on next sign-in.
                            </MudText>
                            <MudStack Spacing="1" Class="mt-2">
                                @foreach (var action in _allRequiredActions)
                                {
                                    var isAssigned = _requiredActions.Contains(action.Key);
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <div>
                                            <MudText Typo="Typo.body1">@action.Value</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetRequiredActionDesc(action.Key)</MudText>
                                        </div>
                                        <MudSwitch T="bool" Value="isAssigned" ValueChanged="@(v => ToggleRequiredAction(action.Key, v))" Color="Color.Primary" />
                                    </MudStack>
                                    <MudDivider />
                                }
                            </MudStack>
                            @if (_requiredActions.Count > 0)
                            {
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center" Class="mt-3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Active:</MudText>
                                    @foreach (var a in _requiredActions)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">@a</MudChip>
                                    }
                                </MudStack>
                            }
                        </MudCardContent>
                    </MudCard>
                }

                <!-- Custom Fields (edit mode only) -->
                @if (!IsCreate)
                {
                    <MudCard Elevation="0" Class="am-card-border">
                        <MudCardHeader>
                            <CardHeaderContent><MudText Typo="Typo.h6">Custom Fields</MudText></CardHeaderContent>
                            <CardHeaderActions><MudButton Variant="Variant.Text" Href="/authmanager/userfields" Size="Size.Small">Manage Fields</MudButton></CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            @if (_fieldDefinitions.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    No custom fields defined yet.
                                    <MudLink Href="/authmanager/userfields">Add field definitions</MudLink>
                                    to collect structured data from this user.
                                </MudText>
                            }
                            else
                            {
                                <MudGrid>
                                    @foreach (var field in _fieldDefinitions.Where(f => f.IsVisible))
                                    {
                                        <MudItem xs="12" sm="6">
                                            @if (field.FieldType == UserFieldType.TextArea)
                                            {
                                                <MudTextField T="string" Value="@GetFieldValue(field.FieldId)"
                                                              ValueChanged="@(v => SetFieldValue(field.FieldId, v ?? ""))"
                                                              Label="@FieldLabel(field)" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                              Placeholder="@field.Placeholder" HelperText="@field.HelpText" />
                                            }
                                            else if (field.FieldType == UserFieldType.Boolean)
                                            {
                                                <MudSwitch T="bool" Value="@(GetFieldValue(field.FieldId) == "true")"
                                                           ValueChanged="@(v => SetFieldValue(field.FieldId, v.ToString().ToLower()))"
                                                           Color="Color.Primary" Label="@FieldLabel(field)" />
                                            }
                                            else if (field.FieldType == UserFieldType.Select)
                                            {
                                                <MudSelect T="string" Value="@GetFieldValue(field.FieldId)"
                                                           ValueChanged="@(v => SetFieldValue(field.FieldId, v ?? ""))"
                                                           Label="@FieldLabel(field)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                           HelperText="@field.HelpText">
                                                    <MudSelectItem T="string" Value="@("")">— Select —</MudSelectItem>
                                                    @foreach (var opt in field.GetSelectOptions())
                                                    {
                                                        <MudSelectItem T="string" Value="@opt">@opt</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                <MudTextField T="string" Value="@GetFieldValue(field.FieldId)"
                                                              ValueChanged="@(v => SetFieldValue(field.FieldId, v ?? ""))"
                                                              Label="@FieldLabel(field)" InputType="@GetFieldInputType(field.FieldType)"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                                              Placeholder="@field.Placeholder" HelperText="@field.HelpText" />
                                            }
                                        </MudItem>
                                    }
                                </MudGrid>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3"
                                           OnClick="SaveCustomFields" Disabled="_savingAttributes">
                                    @(_savingAttributes ? "Saving…" : "Save Custom Fields")
                                </MudButton>
                            }
                        </MudCardContent>
                    </MudCard>
                }

                <!-- Claims -->
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.h6">Claims</MudText></CardHeaderContent>
                        <CardHeaderActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddClaimRow">
                                Add Claim
                            </MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_claims.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No claims assigned. Click "Add Claim" to add one.</MudText>
                        }
                        <MudStack Spacing="2">
                            @foreach (var (claim, index) in _claims.Select((c, i) => (c, i)))
                            {
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudTextField T="string" @bind-Value="claim.Type" Placeholder="Type (e.g. permission)"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField T="string" @bind-Value="claim.Value" Placeholder="Value"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                   OnClick="@(() => RemoveClaim(index))" />
                                </MudStack>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="3">
                <!-- Roles -->
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">Roles</MudText></MudCardHeader>
                    <MudCardContent>
                        @if (_allRoles.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                No roles defined. <MudLink Href="/authmanager/roles/create">Create a role</MudLink>.
                            </MudText>
                        }
                        @foreach (var role in _allRoles)
                        {
                            <MudCheckBox T="bool" Value="_selectedRoles.Contains(role.Name)"
                                         ValueChanged="@(v => ToggleRole(role.Name, v))"
                                         Color="Color.Primary" Label="@role.Name" Dense="true" />
                        }
                    </MudCardContent>
                </MudCard>

                <!-- Temporary Access (edit mode only) -->
                @if (!IsCreate)
                {
                    <MudCard Elevation="0" Class="am-card-border">
                        <MudCardHeader><MudText Typo="Typo.h6">Temporary Access</MudText></MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Grant a role that is automatically revoked at a set time — for time-boxed
                                elevated access. Checked in the Roles list above, but expires on its own.
                            </MudText>
                            @if (_roleExpiries.Count > 0)
                            {
                                <MudStack Spacing="1" Class="mt-2">
                                    @foreach (var (role, expiresAt) in _roleExpiries)
                                    {
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <div>
                                                <MudText Typo="Typo.body2">@role</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Expires @expiresAt.LocalDateTime.ToString("g")</MudText>
                                            </div>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => MakePermanent(role))">
                                                Make permanent
                                            </MudButton>
                                        </MudStack>
                                    }
                                </MudStack>
                            }
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Class="mt-3">
                                <MudSelect T="string" @bind-Value="_tempRoleName" Label="Role" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                                    @foreach (var role in _allRoles)
                                    {
                                        <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudStack>
                            <MudDatePicker Label="Expires" @bind-Date="_tempRoleExpiryDate" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true"
                                       OnClick="GrantTemporaryRole" Class="mt-2">Grant</MudButton>
                        </MudCardContent>
                    </MudCard>
                }

                <!-- Actions -->
                <MudCard Elevation="0" Class="am-card-border">
                    <MudCardHeader><MudText Typo="Typo.h6">Actions</MudText></MudCardHeader>
                    <MudCardContent>
                        @if (_errors.Length > 0)
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">
                                @foreach (var err in _errors)
                                {
                                    <div>@err</div>
                                }
                            </MudAlert>
                        }
                        <MudStack Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Save" Disabled="_saving">
                                @(_saving ? "Saving…" : (IsCreate ? "Create User" : "Save Changes"))
                            </MudButton>
                            <MudButton Variant="Variant.Text" FullWidth="true" Href="/authmanager/users">Cancel</MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string? UserId { get; set; }

    private bool IsCreate => string.IsNullOrEmpty(UserId);
    private bool _loading = true;
    private bool _saving;
    private UserDto? _user;
    private CreateUserDto _form = new();
    private UpdateUserDto _updateForm = new();
    private List<ClaimDto> _claims = [];
    private List<RoleDto> _allRoles = [];
    private HashSet<string> _selectedRoles = [];
    private string[] _errors = [];
    private string _newPassword = "";

    // Custom Fields (stored as custom:fieldId claims)
    private List<UserFieldDefinition> _fieldDefinitions = [];
    private Dictionary<string, string> _fieldValues = [];
    private bool _savingAttributes;

    // Temporary (expiring) role assignments
    private Dictionary<string, DateTimeOffset> _roleExpiries = [];
    private string _tempRoleName = "";
    private DateTime? _tempRoleExpiryDate = DateTime.Today.AddDays(1);

    // Required Actions
    private HashSet<string> _requiredActions = [];
    private static readonly Dictionary<string, string> _allRequiredActions = new()
    {
        ["UpdatePassword"]  = "Update Password",
        ["VerifyEmail"]     = "Verify Email",
        ["ConfigureTOTP"]   = "Configure Authenticator (TOTP)",
        ["UpdateProfile"]   = "Update Profile",
        ["AcceptTerms"]     = "Accept Terms of Service",
    };

    protected override async Task OnInitializedAsync()
    {
        _allRoles = await RoleService.GetRolesAsync();

        if (!IsCreate)
        {
            _user = await UserService.GetUserByIdAsync(UserId!);
            if (_user != null)
            {
                _updateForm = new UpdateUserDto
                {
                    Id = _user.Id,
                    UserName = _user.UserName,
                    Email = _user.Email,
                    PhoneNumber = _user.PhoneNumber,
                    EmailConfirmed = _user.EmailConfirmed,
                    TwoFactorEnabled = _user.TwoFactorEnabled,
                    LockoutEnabled = _user.LockoutEnabled,
                    LockoutEnd = _user.LockoutEnd
                };
                _form = new CreateUserDto
                {
                    UserName = _user.UserName,
                    Email = _user.Email,
                    PhoneNumber = _user.PhoneNumber,
                    EmailConfirmed = _user.EmailConfirmed
                };
                _selectedRoles = [.. _user.Roles];
                _claims = _user.Claims.ToList();

                var actions = await UserService.GetRequiredActionsAsync(UserId!);
                _requiredActions = [.. actions];

                _roleExpiries = await UserService.GetRoleExpiriesAsync(UserId!);

                // Load field definitions and populate values from existing claims
                _fieldDefinitions = await FieldService.GetAllFieldDefinitionsAsync();
                _fieldValues = _fieldDefinitions.ToDictionary(
                    f => f.FieldId,
                    f => _user.Claims
                             .FirstOrDefault(c => c.Type.Equals(f.ClaimType, StringComparison.OrdinalIgnoreCase))
                             ?.Value ?? f.DefaultValue ?? string.Empty);
            }
        }

        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _errors = [];

        try
        {
            bool success;
            string[] errors;

            if (IsCreate)
            {
                _form.Roles = [.. _selectedRoles];
                _form.Claims = _claims;
                (success, errors) = await UserService.CreateUserAsync(_form);
                if (success)
                {
                    Snackbar.Add($"User \"{_form.UserName}\" created successfully.", Severity.Success);
                    Nav.NavigateTo("/authmanager/users");
                }
            }
            else
            {
                _updateForm.UserName = _form.UserName;
                _updateForm.Email = _form.Email;
                _updateForm.PhoneNumber = _form.PhoneNumber;
                _updateForm.EmailConfirmed = _form.EmailConfirmed;
                (success, errors) = await UserService.UpdateUserAsync(_updateForm);

                if (success)
                {
                    // Sync roles
                    foreach (var role in _allRoles)
                    {
                        var hadRole = _user!.Roles.Contains(role.Name);
                        var hasRole = _selectedRoles.Contains(role.Name);
                        if (hadRole && !hasRole)
                            await UserService.RemoveRoleAsync(UserId!, role.Name);
                        else if (!hadRole && hasRole)
                            await UserService.AssignRoleAsync(UserId!, role.Name);
                    }

                    Snackbar.Add("User updated successfully.", Severity.Success);
                    Nav.NavigateTo("/authmanager/users");
                }
            }

            if (!success)
                _errors = errors;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetPassword()
    {
        var (success, errors) = await UserService.ResetPasswordAsync(new ResetPasswordDto
        {
            UserId = UserId!,
            NewPassword = _newPassword
        });

        if (success)
        {
            Snackbar.Add("Password reset successfully.", Severity.Success);
            _newPassword = "";
        }
        else
        {
            _errors = errors;
        }
    }

    private void ToggleRole(string roleName, bool selected)
    {
        if (selected) _selectedRoles.Add(roleName);
        else _selectedRoles.Remove(roleName);
    }

    private void AddClaimRow() => _claims.Add(new ClaimDto());
    private void RemoveClaim(int index) => _claims.RemoveAt(index);

    private async Task ToggleRequiredAction(string action, bool assign)
    {
        if (assign)
        {
            var (ok, errs) = await UserService.AddRequiredActionAsync(UserId!, action);
            if (ok) _requiredActions.Add(action);
            else _errors = errs;
        }
        else
        {
            var (ok, errs) = await UserService.RemoveRequiredActionAsync(UserId!, action);
            if (ok) _requiredActions.Remove(action);
            else _errors = errs;
        }
    }

    private async Task GrantTemporaryRole()
    {
        if (string.IsNullOrWhiteSpace(_tempRoleName) || _tempRoleExpiryDate is null) return;

        var expiresAt = new DateTimeOffset(_tempRoleExpiryDate.Value, TimeZoneInfo.Local.GetUtcOffset(_tempRoleExpiryDate.Value));
        var (ok, errs) = await UserService.AssignTemporaryRoleAsync(UserId!, _tempRoleName, expiresAt);
        if (ok)
        {
            _selectedRoles.Add(_tempRoleName);
            _roleExpiries = await UserService.GetRoleExpiriesAsync(UserId!);
            _tempRoleName = "";
        }
        else
        {
            _errors = errs;
        }
    }

    private async Task MakePermanent(string roleName)
    {
        var (ok, errs) = await UserService.MakeRoleAssignmentPermanentAsync(UserId!, roleName);
        if (ok) _roleExpiries.Remove(roleName);
        else _errors = errs;
    }

    private string GetFieldValue(string fieldId) =>
        _fieldValues.TryGetValue(fieldId, out var v) ? v : string.Empty;

    private void SetFieldValue(string fieldId, string value) =>
        _fieldValues[fieldId] = value;

    private static string FieldLabel(UserFieldDefinition field) =>
        field.IsRequired ? $"{field.DisplayName} *" : field.DisplayName;

    private static InputType GetFieldInputType(UserFieldType type) => type switch
    {
        UserFieldType.Email    => InputType.Email,
        UserFieldType.Phone    => InputType.Telephone,
        UserFieldType.Url      => InputType.Url,
        UserFieldType.Number   => InputType.Number,
        UserFieldType.Date     => InputType.Date,
        UserFieldType.DateTime => InputType.DateTimeLocal,
        _                      => InputType.Text
    };

    private async Task SaveCustomFields()
    {
        _savingAttributes = true;
        _errors = [];

        try
        {
            var user = await UserService.GetUserByIdAsync(UserId!);
            if (user is null) return;

            // For each visible defined field: remove old claim then write new value
            foreach (var field in _fieldDefinitions.Where(f => f.IsVisible))
            {
                var existing = user.Claims.FirstOrDefault(
                    c => c.Type.Equals(field.ClaimType, StringComparison.OrdinalIgnoreCase));
                if (existing is not null)
                    await UserService.RemoveClaimAsync(UserId!, existing);

                var value = GetFieldValue(field.FieldId);
                if (!string.IsNullOrEmpty(value))
                    await UserService.AddClaimAsync(UserId!, new ClaimDto(field.ClaimType, value));
            }

            Snackbar.Add("Custom fields saved.", Severity.Success);
        }
        finally
        {
            _savingAttributes = false;
        }
    }

    private static string GetRequiredActionDesc(string action) => action switch
    {
        "UpdatePassword" => "Force the user to choose a new password before proceeding",
        "VerifyEmail"    => "Send a verification link and require the user to confirm their email",
        "ConfigureTOTP"  => "Prompt the user to set up a TOTP authenticator app (e.g. Google Authenticator)",
        "UpdateProfile"  => "Ask the user to complete their profile information",
        "AcceptTerms"    => "Require the user to accept the current Terms of Service",
        _                => string.Empty
    };
}
