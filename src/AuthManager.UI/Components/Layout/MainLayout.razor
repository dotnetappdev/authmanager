@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject IOptions<AuthManagerOptions> Options
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization

<MudThemeProvider @ref="_themeProvider" Theme="_theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Medium" />
<MudSnackbarProvider />

<MudLayout Class="@LayoutCssClass">
    <NavMenu CurrentTheme="_mode" OnThemeChange="ChangeTheme" />

    <MudMainContent Class="am-main-content">
        @if (_isImpersonating)
        {
            <MudAlert Severity="Severity.Warning" Class="rounded-0 mb-0" Style="position:sticky;top:0;z-index:1300;">
                Impersonating <strong>@_impersonatedUser</strong> as SuperAdmin —
                <MudLink Href="@_exitImpersonationUrl" Color="Color.Inherit" Underline="Underline.Always">Exit Impersonation</MudLink>
            </MudAlert>
        }
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="am-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider _themeProvider = default!;
    private bool   _isDark;
    private AuthManagerTheme _mode = AuthManagerTheme.Light;
    private MudTheme _theme = AuthManagerThemeProvider.Build();

    private bool   _isImpersonating;
    private string _impersonatedUser    = "";
    private string _exitImpersonationUrl = "";

    private string? LayoutCssClass => _mode switch
    {
        AuthManagerTheme.Dark => "mud-theme-dark",
        AuthManagerTheme.HighContrast => "am-high-contrast",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        // Applied synchronously (no JS interop) so the configured default shows up on the
        // very first paint, including the static SSR pass before any circuit connects —
        // OnAfterRenderAsync below only runs once a circuit is live, so a JS-only default
        // would otherwise never apply to prerendered/non-interactive-yet output.
        ApplyMode(Options.Value.DefaultTheme == AuthManagerTheme.System ? AuthManagerTheme.Light : Options.Value.DefaultTheme);

        var authState = await AuthState.GetAuthenticationStateAsync();
        var user      = authState.User;

        if (user.FindFirst("am:impersonating")?.Value == "true")
        {
            _isImpersonating     = true;
            _impersonatedUser    = user.Identity?.Name ?? "Unknown";
            var prefix           = Options.Value.RoutePrefix.Trim('/');
            _exitImpersonationUrl = $"/{prefix}/api/exit-impersonation";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JS interop isn't available during the server-side prerendering pass — this
            // firstRender call happens twice (once during prerendering, once for real once
            // the circuit connects), and the first one always throws here. Without this
            // guard the exception aborts the method before DefaultTheme is ever applied,
            // so a configured dark/system default silently never takes effect.
            string? savedTheme = null;
            try
            {
                savedTheme = await JS.InvokeAsync<string?>("authManager.getTheme");
            }
            catch (InvalidOperationException)
            {
            }

            switch (savedTheme)
            {
                case "dark":
                    ApplyMode(AuthManagerTheme.Dark);
                    break;
                case "light":
                    ApplyMode(AuthManagerTheme.Light);
                    break;
                case "high-contrast":
                    ApplyMode(AuthManagerTheme.HighContrast);
                    break;
                default:
                    var defaultTheme = Options.Value.DefaultTheme;
                    if (defaultTheme == AuthManagerTheme.System)
                    {
                        try
                        {
                            var prefersDark = await JS.InvokeAsync<bool>("authManager.prefersDarkMode");
                            ApplyMode(prefersDark ? AuthManagerTheme.Dark : AuthManagerTheme.Light);
                        }
                        catch (InvalidOperationException)
                        {
                        }
                    }
                    else
                    {
                        ApplyMode(defaultTheme);
                    }
                    break;
            }
            StateHasChanged();
        }
    }

    private void ApplyMode(AuthManagerTheme mode)
    {
        _mode   = mode;
        _isDark = mode == AuthManagerTheme.Dark;
        _theme  = mode == AuthManagerTheme.HighContrast
            ? AuthManagerThemeProvider.BuildHighContrast()
            : AuthManagerThemeProvider.Build();
    }

    private async Task ChangeTheme(AuthManagerTheme mode)
    {
        ApplyMode(mode);
        var jsValue = mode switch
        {
            AuthManagerTheme.Dark => "dark",
            AuthManagerTheme.HighContrast => "high-contrast",
            _ => "light"
        };
        await JS.InvokeVoidAsync("authManager.setTheme", jsValue);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync() => await ValueTask.CompletedTask;
}
