@using AuthManagerSample.BlazorWebApp.Identity
@page "/account/register"
@* SSR so we have HttpContext access for SignInManager after account creation *@
@attribute [ExcludeFromInteractiveRouting]

@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject ILogger<Register> Logger

<PageTitle>Create Account</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h5" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
            Create Account
        </MudText>

        @if (_errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @foreach (var err in _errors)
                {
                    <div>@err</div>
                }
            </MudAlert>
        }

        @* Native Blazor form components are required here (not MudTextField) — this page is
           static SSR (no @rendermode) so SignInManager can write the auth cookie directly on
           HttpContext. Only InputBase-derived components participate in
           [SupplyParameterFromForm] model binding on a static form POST. *@
        <EditForm Model="Input" OnValidSubmit="HandleRegister" FormName="register" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="am-validation-summary mb-3" />

            <div class="am-field mb-3">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="Input.Email" class="am-input" autocomplete="username" />
            </div>

            <div class="am-field mb-3">
                <label for="password">Password</label>
                <InputText id="password" type="password" @bind-Value="Input.Password" class="am-input" autocomplete="new-password" />
                <span class="am-help-text">Min 8 chars, uppercase, digit required</span>
            </div>

            <div class="am-field mb-4">
                <label for="confirmPassword">Confirm Password</label>
                <InputText id="confirmPassword" type="password" @bind-Value="Input.ConfirmPassword" class="am-input" autocomplete="new-password" />
            </div>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large">
                Create Account
            </MudButton>
        </EditForm>

        <MudDivider Class="my-4" />
        <MudLink Href="/account/login">Already have an account? Sign in</MudLink>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromForm]
    private RegisterInput Input { get; set; } = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private List<string> _errors = [];

    private async Task HandleRegister()
    {
        var user = new ApplicationUser
        {
            UserName = Input.Email,
            Email    = Input.Email,
        };

        var result = await UserManager.CreateAsync(user, Input.Password);
        if (!result.Succeeded)
        {
            _errors = result.Errors.Select(e => e.Description).ToList();
            return;
        }

        Logger.LogInformation("New account created for {Email}.", Input.Email);

        // Sign in immediately after registration
        await SignInManager.SignInAsync(user, isPersistent: false);
        Navigation.NavigateTo("/", forceLoad: true);
    }

    public sealed class RegisterInput
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(8)]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
