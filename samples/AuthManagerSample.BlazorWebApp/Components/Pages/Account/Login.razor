@using AuthManagerSample.BlazorWebApp.Identity
@page "/account/login"
@* SSR (no @rendermode) so HttpContext is available for SignInManager *@
@attribute [ExcludeFromInteractiveRouting]

@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Sign In</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h5" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
            Sign In
        </MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        @* Native Blazor form components are required here (not MudTextField/MudCheckBox) —
           this page is static SSR (no @rendermode) so SignInManager can write the auth
           cookie directly on HttpContext. Only InputBase-derived components participate
           in [SupplyParameterFromForm] model binding on a static form POST. *@
        <EditForm Model="Input" OnValidSubmit="HandleLogin" FormName="login" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="am-validation-summary mb-3" />

            <div class="am-field mb-3">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="Input.Email" class="am-input" autocomplete="username" />
            </div>

            <div class="am-field mb-3">
                <label for="password">Password</label>
                <InputText id="password" type="password" @bind-Value="Input.Password" class="am-input" autocomplete="current-password" />
            </div>

            <div class="am-field mb-4 am-checkbox-row">
                <InputCheckbox id="rememberMe" @bind-Value="Input.RememberMe" />
                <label for="rememberMe">Remember me</label>
            </div>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large">
                Sign In
            </MudButton>
        </EditForm>

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.SpaceBetween">
            <MudLink Href="/account/register">Create an account</MudLink>
            <MudLink Href="/account/forgot-password">Forgot password?</MudLink>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? _errorMessage;

    private async Task HandleLogin()
    {
        // Look up by email explicitly — UserName and Email can differ (e.g. the
        // seeded SuperAdmin has UserName "superadmin" but a different Email),
        // and PasswordSignInAsync(string, ...) matches on UserName only.
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            _errorMessage = "Invalid email or password.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            user,
            Input.Password,
            Input.RememberMe,
            lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Logger.LogInformation("User {Email} signed in.", Input.Email);
            Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
            return;
        }

        if (result.IsLockedOut)
        {
            _errorMessage = "This account is locked. Please try again later or contact support.";
            Logger.LogWarning("Account locked out: {Email}", Input.Email);
            return;
        }

        if (result.RequiresTwoFactor)
        {
            Navigation.NavigateTo("/account/two-factor", forceLoad: true);
            return;
        }

        _errorMessage = "Invalid email or password.";
    }

    public sealed class LoginInput
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
