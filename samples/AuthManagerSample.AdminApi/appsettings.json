{
  "Database": {
    "_comment": "SQLite (default, zero install) or SqlServer — see ConnectionStrings:Default below.",
    "Provider": "SQLite"
  },
  "ConnectionStrings": {
    "_comment": "SQLite: 'Data Source=adminapi.db'. SQL Server: 'Server=.;Database=AdminApi;Trusted_Connection=True;TrustServerCertificate=True'.",
    "Default": "Data Source=adminapi.db"
  },
  "Jwt": {
    "SecretKey": "change-this-to-a-long-random-secret-key-in-production-min-32-chars",
    "Issuer": "https://localhost:5210",
    "Audience": "https://localhost:5210",
    "AccessTokenExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
